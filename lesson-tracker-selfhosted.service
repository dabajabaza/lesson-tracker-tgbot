# Юнит systemd --user для self-hosted (aiogram) версии.
# ВНИМАНИЕ: не запускать одновременно с serverless-ботом (lesson-tracker-bot) —
# два процесса конфликтуют за getUpdates (Telegram 409). Это замена, не дополнение.
#
# Установка (из корня репозитория, после подготовки .venv и токена):
#   systemctl --user disable --now lesson-tracker-bot
#   cp lesson-tracker-selfhosted.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now lesson-tracker-selfhosted
# Логи: journalctl --user -u lesson-tracker-selfhosted -f

[Unit]
Description=LessonTracker42Bot — self-hosted (aiogram, long polling)
After=network-online.target
# Терпим многоминутный провал прокси/сети без вечного failed: редкие рестарты
# (watchdog-kill при обрыве и т.п.) разнесены RestartSec=15, а окно/burst
# подобраны так, чтобы блип не сжигал лимит. Стартовую недоступность прокси
# бот теперь переживает сам (_establish_connection) и вовсе не выходит.
StartLimitIntervalSec=900
StartLimitBurst=60

[Service]
# notify: бот сам сообщает READY=1 (связь с Telegram установлена) и периодически
# WATCHDOG=1. Перестал пинговать дольше WatchdogSec (завис на мёртвом соединении
# после смены сети / провала прокси) — systemd убивает и перезапускает.
Type=notify
WatchdogSec=90
WorkingDirectory=%h/Projects/lesson-tracker-tgbot
ExecStart=%h/Projects/lesson-tracker-tgbot/.venv/bin/python -m bot
# Прямой доступ к api.telegram.org в этой сети режется — ходим через прокси.
Environment=TELEGRAM_PROXY=http://127.0.0.1:1080
# Restart=always покрывает и штатный выход, и срабатывание watchdog.
Restart=always
RestartSec=15

[Install]
WantedBy=default.target

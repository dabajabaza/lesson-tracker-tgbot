# Общий gitignore монорепо. Специфика serverless/ и selfhosted/ — в их
# собственных .gitignore.

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Секреты и локальные данные
.bot-token
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Машинно-специфичное
.npmrc
